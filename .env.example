# Root reference of every credential the project needs, across both lanes.
# Copy the relevant subset into apps/web/.env.local and pipeline/.env — never commit
# real values (both are gitignored).

# --- Supabase (shared) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-side only (webhook, pipeline) — never expose to the browser

# --- Stripe (apps/web) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=                 # the course's Stripe Price/Payment Link id

# --- Cloudflare Stream (both lanes: pipeline uploads, web embeds) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# --- LLM (pipeline: script + quiz generation, and the RAG stretch goal) ---
ANTHROPIC_API_KEY=               # or OPENAI_API_KEY / GEMINI_API_KEY, whichever the team settles on

# --- HeyGen (pipeline: avatar video generation) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=                 # the custom/cloned avatar id to use for every lesson
HEYGEN_VOICE_ID=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
